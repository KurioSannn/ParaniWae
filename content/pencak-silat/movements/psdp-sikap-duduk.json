  "module_hint": "Sikap duduk",
  "shared_context": {
    "definition": {"text": "Sikap duduk adalah sikap dasar 'permainan bawah'. Menurut Atok Iskandar (1996, dikutip Nugroho) ada lima sikap duduk: duduk biasa, sila, trapsila/mengorak sila, simpuh, dan sempok/depok.", "source_ids": ["src.nugroho.2005"], "locator": "hlm. 148"},
    "herdiana": {"text": "Herdiana juga mendaftar sikap jengkeng, jongkok, duduk, sila, simpuh, dan depok sebagai sikap yang perlu dikuasai, tanpa uraian pelaksanaan.", "source_ids": ["src.herdiana.2008"], "locator": "hlm. 16–17"}
  },
