  "shared_context": {
    "hindaran": {"text": "Hindaran adalah pembelaan dengan memindahkan tubuh dari arah sasaran serangan lawan, dilakukan dengan melangkahkan kaki. Pelaksanaannya ditentukan oleh sikap kuda-kuda, sikap tubuh, dan sikap tangan.", "source_ids": ["src.herdiana.2008"], "locator": "hlm. 26–27"},
    "elakan": {"text": "Elakan adalah pembelaan dengan memindahkan sasaran serangan tanpa memindahkan pijakan kaki; hanya mengandalkan perubahan sikap tubuh.", "source_ids": ["src.herdiana.2008"], "locator": "hlm. 28–29"},
    "framing": {"text": "Sumber menguraikan hindaran dan elakan sebagai jawaban atas serangan lawan dan tidak menyatakan bentuk latihan tanpa lawan. SILATARA mendokumentasikan perubahan sikap tubuhnya saja; bentuk solo BELUM dinyatakan sah oleh instruktur, sehingga kelas keselamatan = supervised_only dan tidak dibuka untuk Practice Studio.", "basis": "editorial"}
  },
