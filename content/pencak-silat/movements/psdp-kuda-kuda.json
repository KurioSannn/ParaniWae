  "tradition_id": "trd.psdp",
  "module_hint": "Kuda-kuda",
  "shared_context": {
    "definition": {"text": "Kuda-kuda adalah posisi kaki tertentu sebagai dasar tumpuan untuk melakukan sikap dan gerak bela-serang (Moh. Saleh 1986, dikutip Nugroho). Fungsinya melatih otot kaki dan keseimbangan; badan harus setimbang dan stabil, tetapi tetap mudah bergerak.", "source_ids": ["src.nugroho.2005"], "locator": "hlm. 146"},
    "herdiana": {"text": "Herdiana menyebut kuda-kuda sebagai sikap waspada sebelum bergerak atau menjalankan jurus, dan menekankan pemahaman arah 8 penjuru mata angin karena titik tengah arah menjadi tempat berdiri dan acuan langkah.", "source_ids": ["src.herdiana.2008"], "locator": "hlm. 12–13"},
    "variance_note": {"text": "Nugroho dan Herdiana tidak sepenuhnya sama dalam merinci tiap kuda-kuda (lihat 'variants' tiap gerakan). Keduanya bukan standar perguruan tertentu; lebar, tinggi, dan arah kaki dapat berbeda di tiap aliran.", "basis": "editorial"}
  },
