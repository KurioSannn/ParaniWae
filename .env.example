# Salin menjadi .env (otomatis oleh: make setup). JANGAN commit .env.
# Semua nilai punya default aman-untuk-dev di docker-compose.yml, jadi .env bersifat opsional.

APP_ENV=development

# --- PostgreSQL (dev lokal saja; ganti untuk lingkungan lain) ---
POSTGRES_USER=silatara
POSTGRES_PASSWORD=ganti-dengan-sandi-dev-anda
POSTGRES_DB=silatara

# --- Port host (hanya loopback 127.0.0.1) ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=5432

# --- Backend ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RUN_MIGRATIONS=true
SEED_DEMO_DATA=true
EXPOSE_DEMO_DATA=true

# --- Frontend ---
# Kosong (disarankan) = browser memanggil /api/v1 pada origin frontend; Next meneruskan ke backend
# (cookie sesi first-party, lihat docs/adr/0002). Isi hanya bila API di origin lain.
NEXT_PUBLIC_API_URL=

# --- UID/GID host (penting di Linux agar file bind-mount tidak dimiliki root/uid lain) ---
# make setup mengisi otomatis. macOS/Windows: biarkan 1000.
HOST_UID=1000
HOST_GID=1000
